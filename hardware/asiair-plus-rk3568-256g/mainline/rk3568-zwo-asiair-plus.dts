// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * ZWO ASIAIR Plus (AirPlus-RK3568) - mainline Linux device tree.
 *
 * Ported from the stock ZWO 4.19.219 BSP tree (../asiair-plus.dts) and
 * the pin map in ../inventory.md. Written against mainline v7.3.
 *
 * Differences from stock:
 *  - ZWO's closed pwm_gpio.ko / "airplus-gpios" node is replaced by the
 *    mainline pwm-gpio driver (CONFIG_PWM_GPIO, 6.11+): one software-PWM
 *    channel per DC port plus one for the piezo, which is wired to
 *    pwm-beeper. LEDs use gpio-leds, the button uses gpio-keys.
 *  - WiFi/BT (AP6256 = BCM43456) use brcmfmac / hci_uart-bcm instead of
 *    bcmdhd.
 *
 * Items marked VERIFY need checking on real hardware.
 */

/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include "rk3568.dtsi"

/ {
	model = "ZWO ASIAIR Plus";
	compatible = "zwo,asiair-plus", "rockchip,rk3568";

	aliases {
		ethernet0 = &gmac1;
		mmc0 = &sdhci;
		mmc1 = &sdmmc0;
		mmc2 = &sdmmc1;
	};

	chosen {
		/* Stock debug console: uart2m0 @ 1.5 Mbaud (fiq-debugger serial-id 2) */
		stdout-path = "serial2:1500000n8";
		/*
		 * Stock U-Boot takes the command line from here (the boot.img
		 * header cmdline is empty). root= is the stock rootfs (p7) PARTUUID.
		 */
		bootargs = "earlycon=uart8250,mmio32,0xfe660000 console=ttyS2,1500000n8 root=PARTUUID=614e0000-0000-4b53-8000-1d2800005999 rootfstype=ext4 rootwait rw systemd.gpt_auto=0 coherent_pool=8M";
	};

	/* RGMII 125 MHz reference supplied by the PHY (stock external-gmac1-clock) */
	gmac1_clkin: external-gmac1-clock {
		compatible = "fixed-clock";
		clock-frequency = <125000000>;
		clock-output-names = "gmac1_clkin";
		#clock-cells = <0>;
	};

	/* --- Power tree (from stock regulator-fixed nodes) --- */

	dc_12v: regulator-dc-12v {
		compatible = "regulator-fixed";
		regulator-name = "dc_12v";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <12000000>;
		regulator-max-microvolt = <12000000>;
	};

	vcc3v3_sys: regulator-vcc3v3-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&dc_12v>;
	};

	vcc5v0_sys: regulator-vcc5v0-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&dc_12v>;
	};

	vcc5v0_usb: regulator-vcc5v0-usb {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_usb";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&dc_12v>;
	};

	/* --- WiFi power sequence (AP6256 WL_REG_ON = GPIO2_B1) --- */

	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		clocks = <&rk809 1>;
		clock-names = "ext_clock";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_enable_h>;
		post-power-on-delay-ms = <200>;
		reset-gpios = <&gpio2 RK_PB1 GPIO_ACTIVE_LOW>;
	};

	/* --- LEDs: GPIO0_D3..D6 cluster --- */

	leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&led_pins>;

		/*
		 * Stock drives this on from boot. Keep it that way: it may be
		 * part of what the power MCU watches (see README.md).
		 */
		led-power {
			label = "airplus:power";
			function = LED_FUNCTION_POWER;
			gpios = <&gpio0 RK_PD4 GPIO_ACTIVE_LOW>;
			default-state = "on";
			linux,default-trigger = "default-on";
		};

		led-activity {
			label = "airplus:activity";
			function = LED_FUNCTION_ACTIVITY;
			gpios = <&gpio0 RK_PD3 GPIO_ACTIVE_LOW>;
			default-state = "off";
			linux,default-trigger = "activity";
		};

		/* VERIFY polarity: stock shows D5 "out hi" while lit */
		led-network {
			label = "airplus:network";
			function = LED_FUNCTION_WLAN;
			gpios = <&gpio0 RK_PD5 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};

		/* VERIFY polarity */
		led-status {
			label = "airplus:status";
			function = LED_FUNCTION_STATUS;
			gpios = <&gpio0 RK_PD6 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
	};

	/* --- Front button: GPIO0_A5, pulled up, presumably active low --- */

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&button_pin>;

		button {
			label = "airplus:button";
			/* Not KEY_POWER on purpose: userspace decides what it does */
			linux,code = <BTN_0>;
			gpios = <&gpio0 RK_PA5 GPIO_ACTIVE_LOW>;
			debounce-interval = <50>;
			wakeup-source;
		};
	};

	/*
	 * --- 12V DC power ports: software PWM via mainline pwm-gpio ---
	 *
	 * Each port is its own pwm-gpio controller (one channel, index 0),
	 * exposed at /sys/class/pwm/pwmchipN. 100% duty = plain on, 0% = off,
	 * anything between = dew-heater style dimming.
	 * The port label LEDs are believed to be wired to the MOSFET gate.
	 */

	pwm_dc1: pwm-dc1 {
		compatible = "pwm-gpio";
		#pwm-cells = <3>;
		gpios = <&gpio4 RK_PC6 GPIO_ACTIVE_HIGH>;
	};

	pwm_dc2: pwm-dc2 {
		compatible = "pwm-gpio";
		#pwm-cells = <3>;
		gpios = <&gpio4 RK_PC5 GPIO_ACTIVE_HIGH>;
	};

	pwm_dc3: pwm-dc3 {
		compatible = "pwm-gpio";
		#pwm-cells = <3>;
		gpios = <&gpio4 RK_PC2 GPIO_ACTIVE_HIGH>;
	};

	pwm_dc4: pwm-dc4 {
		compatible = "pwm-gpio";
		#pwm-cells = <3>;
		gpios = <&gpio4 RK_PC3 GPIO_ACTIVE_HIGH>;
	};

	/* --- Piezo buzzer: GPIO0_B7, software PWM -> input beeper --- */

	pwm_buzzer: pwm-buzzer {
		compatible = "pwm-gpio";
		#pwm-cells = <3>;
		gpios = <&gpio0 RK_PB7 GPIO_ACTIVE_HIGH>;
	};

	beeper {
		compatible = "pwm-beeper";
		/* 1 kHz period, matches stock beep (period 1 ms) */
		pwms = <&pwm_buzzer 0 1000000 0>;
	};
};

&combphy0 {
	/* USB3 OTG port (usb_host0_xhci) */
	status = "okay";
};

&combphy1 {
	/* USB3 host port (usb_host1_xhci) */
	status = "okay";
};

&cpu0 {
	cpu-supply = <&vdd_cpu>;
};

&cpu1 {
	cpu-supply = <&vdd_cpu>;
};

&cpu2 {
	cpu-supply = <&vdd_cpu>;
};

&cpu3 {
	cpu-supply = <&vdd_cpu>;
};

/* --- Ethernet: GMAC1, m0 pins, RGMII, 125 MHz clock from the PHY --- */

&gmac1 {
	assigned-clocks = <&cru SCLK_GMAC1_RX_TX>, <&cru SCLK_GMAC1>;
	assigned-clock-parents = <&cru SCLK_GMAC1_RGMII_SPEED>, <&gmac1_clkin>;
	clock_in_out = "input";
	phy-handle = <&rgmii_phy1>;
	/* Stock uses MAC-side delays with plain "rgmii" */
	phy-mode = "rgmii";
	tx_delay = <0x4f>;
	rx_delay = <0x26>;
	pinctrl-names = "default";
	pinctrl-0 = <&gmac1m0_miim
		     &gmac1m0_tx_bus2
		     &gmac1m0_rx_bus2
		     &gmac1m0_rgmii_clk
		     &gmac1m0_rgmii_bus
		     &gmac1m0_clkinout>;
	status = "okay";
};

&mdio1 {
	rgmii_phy1: ethernet-phy@0 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x0>;
		/* Stock snps,reset-gpio GPIO1_B1, delays 0 / 20 ms / 100 ms */
		reset-gpios = <&gpio1 RK_PB1 GPIO_ACTIVE_LOW>;
		reset-assert-us = <20000>;
		reset-deassert-us = <100000>;
	};
};

&gpu {
	mali-supply = <&vdd_gpu>;
	status = "okay";
};

/* --- I2C0: CPU regulator + RK809 PMIC --- */

&i2c0 {
	status = "okay";

	vdd_cpu: regulator@1c {
		compatible = "tcs,tcs4525";
		reg = <0x1c>;
		fcs,suspend-voltage-selector = <1>;
		regulator-name = "vdd_cpu";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <712500>;
		regulator-max-microvolt = <1390000>;
		regulator-ramp-delay = <2300>;
		vin-supply = <&vcc5v0_sys>;

		regulator-state-mem {
			regulator-off-in-suspend;
		};
	};

	rk809: pmic@20 {
		compatible = "rockchip,rk809";
		reg = <0x20>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PA3 IRQ_TYPE_LEVEL_LOW>;
		#clock-cells = <1>;
		clock-output-names = "rk808-clkout1", "rk808-clkout2";
		pinctrl-names = "default";
		pinctrl-0 = <&pmic_int>;
		system-power-controller;
		wakeup-source;

		vcc1-supply = <&vcc3v3_sys>;
		vcc2-supply = <&vcc3v3_sys>;
		vcc3-supply = <&vcc3v3_sys>;
		vcc4-supply = <&vcc3v3_sys>;
		vcc5-supply = <&vcc3v3_sys>;
		vcc6-supply = <&vcc3v3_sys>;
		vcc7-supply = <&vcc3v3_sys>;
		vcc8-supply = <&vcc3v3_sys>;
		vcc9-supply = <&vcc3v3_sys>;

		regulators {
			vdd_logic: DCDC_REG1 {
				regulator-name = "vdd_logic";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1350000>;
				regulator-init-microvolt = <900000>;
				regulator-ramp-delay = <6001>;
				regulator-initial-mode = <0x2>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vdd_gpu: DCDC_REG2 {
				regulator-name = "vdd_gpu";
				regulator-always-on;
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1350000>;
				regulator-init-microvolt = <900000>;
				regulator-ramp-delay = <6001>;
				regulator-initial-mode = <0x2>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcc_ddr: DCDC_REG3 {
				regulator-name = "vcc_ddr";
				regulator-always-on;
				regulator-boot-on;
				regulator-initial-mode = <0x2>;

				regulator-state-mem {
					regulator-on-in-suspend;
				};
			};

			vdd_npu: DCDC_REG4 {
				regulator-name = "vdd_npu";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1350000>;
				regulator-init-microvolt = <900000>;
				regulator-ramp-delay = <6001>;
				regulator-initial-mode = <0x2>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcc_1v8: DCDC_REG5 {
				regulator-name = "vcc_1v8";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vdda0v9_image: LDO_REG1 {
				regulator-name = "vdda0v9_image";
				regulator-always-on;
				regulator-min-microvolt = <900000>;
				regulator-max-microvolt = <900000>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vdda_0v9: LDO_REG2 {
				regulator-name = "vdda_0v9";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <900000>;
				regulator-max-microvolt = <900000>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vdda0v9_pmu: LDO_REG3 {
				regulator-name = "vdda0v9_pmu";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <900000>;
				regulator-max-microvolt = <900000>;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <900000>;
				};
			};

			vccio_acodec: LDO_REG4 {
				regulator-name = "vccio_acodec";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vccio_sd: LDO_REG5 {
				regulator-name = "vccio_sd";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcc3v3_pmu: LDO_REG6 {
				regulator-name = "vcc3v3_pmu";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <3300000>;
				};
			};

			vcca_1v8: LDO_REG7 {
				regulator-name = "vcca_1v8";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcca1v8_pmu: LDO_REG8 {
				regulator-name = "vcca1v8_pmu";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1800000>;
				};
			};

			vcca1v8_image: LDO_REG9 {
				regulator-name = "vcca1v8_image";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcc_3v3: SWITCH_REG1 {
				regulator-name = "vcc_3v3";
				regulator-always-on;
				regulator-boot-on;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcc3v3_sd: SWITCH_REG2 {
				regulator-name = "vcc3v3_sd";
				regulator-always-on;
				regulator-boot-on;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};
		};
	};
};

&i2c1 {
	/* Enabled on stock with no children; left on for probing */
	status = "okay";
};

&pinctrl {
	/*
	 * USB port power enables (GPIO0_C2, A6, B0, C7). Stock leaves them as
	 * inputs with pull-ups = power on; driving one low cuts that port.
	 * Hogged here as pull-up inputs so ports are on at boot, still
	 * switchable from userspace with gpioset (gpiochip0 lines 18/6/8/23).
	 */
	pinctrl-names = "default";
	pinctrl-0 = <&usb_power_pins>;

	airplus {
		usb_power_pins: usb-power-pins {
			rockchip,pins =
				<0 RK_PC2 RK_FUNC_GPIO &pcfg_pull_up>,
				<0 RK_PA6 RK_FUNC_GPIO &pcfg_pull_up>,
				<0 RK_PB0 RK_FUNC_GPIO &pcfg_pull_up>,
				<0 RK_PC7 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		button_pin: button-pin {
			rockchip,pins = <0 RK_PA5 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		led_pins: led-pins {
			rockchip,pins =
				<0 RK_PD3 RK_FUNC_GPIO &pcfg_pull_none>,
				<0 RK_PD4 RK_FUNC_GPIO &pcfg_pull_none>,
				<0 RK_PD5 RK_FUNC_GPIO &pcfg_pull_none>,
				<0 RK_PD6 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	bluetooth {
		bt_reg_on_h: bt-reg-on-h {
			rockchip,pins = <2 RK_PB7 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		bt_wake_host_h: bt-wake-host-h {
			rockchip,pins = <2 RK_PC0 RK_FUNC_GPIO &pcfg_pull_down>;
		};
	};

	pmic {
		pmic_int: pmic-int {
			rockchip,pins = <0 RK_PA3 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	sdio-pwrseq {
		wifi_enable_h: wifi-enable-h {
			rockchip,pins = <2 RK_PB1 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	wifi {
		wifi_host_wake_irq: wifi-host-wake-irq {
			rockchip,pins = <2 RK_PB2 RK_FUNC_GPIO &pcfg_pull_down>;
		};
	};
};

/* I/O voltage domains copied from stock. Getting these wrong can damage pads. */
&pmu_io_domains {
	pmuio1-supply = <&vcc3v3_pmu>;
	pmuio2-supply = <&vcc3v3_pmu>;
	vccio1-supply = <&vccio_acodec>;
	/* vccio2 not set in stock; eMMC/boot pins, 1.8 V like every RK3568 ref board */
	vccio2-supply = <&vcc_1v8>;
	vccio3-supply = <&vccio_sd>;
	vccio4-supply = <&vcc_1v8>;
	vccio5-supply = <&vcc_1v8>;	/* stock: 1.8 V (EVB uses 3.3 V) */
	vccio6-supply = <&vcc_1v8>;
	vccio7-supply = <&vcc_3v3>;
	status = "okay";
};

&saradc {
	vref-supply = <&vcca_1v8>;
	status = "okay";
};

/* eMMC (256 GB) */
&sdhci {
	bus-width = <8>;
	max-frequency = <200000000>;
	non-removable;
	pinctrl-names = "default";
	pinctrl-0 = <&emmc_bus8 &emmc_clk &emmc_cmd &emmc_datastrobe>;
	status = "okay";
};

/* SD card slot: enabled on stock (card detect via sdmmc0_det) */
&sdmmc0 {
	bus-width = <4>;
	cap-sd-highspeed;
	cap-mmc-highspeed;
	card-detect-delay = <1500>;
	disable-wp;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc0_bus4 &sdmmc0_clk &sdmmc0_cmd &sdmmc0_det>;
	sd-uhs-sdr104;
	vmmc-supply = <&vcc3v3_sd>;
	vqmmc-supply = <&vccio_sd>;
	status = "okay";
};

/* SDIO WiFi: AP6256 (BCM43456) */
&sdmmc1 {
	bus-width = <4>;
	cap-sd-highspeed;
	cap-sdio-irq;
	keep-power-in-suspend;
	max-frequency = <100000000>;
	mmc-pwrseq = <&sdio_pwrseq>;
	non-removable;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc1_bus4 &sdmmc1_cmd &sdmmc1_clk>;
	sd-uhs-sdr104;
	vmmc-supply = <&vcc3v3_sys>;
	vqmmc-supply = <&vcc_1v8>;
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	wifi@1 {
		compatible = "brcm,bcm4345-fmac", "brcm,bcm4329-fmac";
		reg = <1>;
		interrupt-parent = <&gpio2>;
		interrupts = <RK_PB2 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "host-wake";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_host_wake_irq>;
	};
};

&tsadc {
	rockchip,hw-tshut-mode = <1>;
	rockchip,hw-tshut-polarity = <0>;
	status = "okay";
};

/* Bluetooth: AP6256 BT on uart1m0 with hardware flow control */
&uart1 {
	dma-names = "tx", "rx";
	pinctrl-names = "default";
	pinctrl-0 = <&uart1m0_xfer &uart1m0_ctsn &uart1m0_rtsn>;
	uart-has-rtscts;
	status = "okay";

	bluetooth {
		compatible = "brcm,bcm4345c5";
		clocks = <&rk809 1>;
		clock-names = "lpo";
		host-wakeup-gpios = <&gpio2 RK_PC0 GPIO_ACTIVE_HIGH>;
		shutdown-gpios = <&gpio2 RK_PB7 GPIO_ACTIVE_HIGH>;
		max-speed = <1500000>;
		pinctrl-names = "default";
		pinctrl-0 = <&bt_reg_on_h &bt_wake_host_h>;
		vbat-supply = <&vcc3v3_sys>;
		vddio-supply = <&vcc_1v8>;
	};
};

/* Debug console */
&uart2 {
	status = "okay";
};

/* --- USB --- */

&usb_host0_ehci {
	status = "okay";
};

&usb_host0_ohci {
	status = "okay";
};

/* Stock runs this controller as OTG; host-only here since all ports are type A */
&usb_host0_xhci {
	dr_mode = "host";
	status = "okay";
};

&usb_host1_ehci {
	status = "okay";
};

&usb_host1_ohci {
	status = "okay";
};

&usb_host1_xhci {
	status = "okay";
};

&usb2phy0 {
	status = "okay";
};

&usb2phy0_host {
	phy-supply = <&vcc5v0_usb>;
	status = "okay";
};

&usb2phy0_otg {
	phy-supply = <&vcc5v0_usb>;
	status = "okay";
};

&usb2phy1 {
	status = "okay";
};

&usb2phy1_host {
	phy-supply = <&vcc5v0_usb>;
	status = "okay";
};

&usb2phy1_otg {
	phy-supply = <&vcc5v0_usb>;
	status = "okay";
};
