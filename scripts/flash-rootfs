#!/bin/bash
set -e

# Everything below needs root (raw USB flashing, loop-mounting the image).
if [ "$(id -u)" -ne 0 ]; then
    echo "ERROR: this script must be run as root:" >&2
    echo "  sudo $0 $*" >&2
    exit 1
fi

# Flash a rootfs image to ASIAIR Plus partition 7.
# Accepts both raw .img and compressed .img.gz files.
#
# Usage: sudo scripts/flash-rootfs [--no-wifi] [rootfs-image]
#   --no-wifi  skip the WiFi hotspot setup (also: OPENASTRO_WIFI=no); the
#              hotspot is otherwise enabled by default with the fleet defaults
#              (customize via OPENASTRO_SSID / OPENASTRO_PSK / OPENASTRO_COUNTRY)

REPODIR="$(cd "$(dirname "$0")/.." && pwd)"
TOOL="$REPODIR/rk-flashtool"
# shellcheck source=lib/wifi.sh
. "$REPODIR/scripts/lib/wifi.sh"
IMAGES_DIR="$REPODIR/images"
# shellcheck source=lib/release.sh
. "$REPODIR/scripts/lib/release.sh"

# pick_workdir() is provided by scripts/lib/wifi.sh (sourced above).

# Search order for rootfs image: arg > current-release cache in images/ > ../asiair-image/
find_rootfs() {
    local paths=("$IMAGES_DIR/astrolinux-trixie-rk3568-$RELEASE_TAG" "$(dirname "$REPODIR")/asiair-image/rootfs-stock")
    for p in "${paths[@]}"; do
        for ext in .img .img.gz; do
            [ -f "${p}${ext}" ] && echo "${p}${ext}" && return
        done
    done
    return 0  # no image found is not an error (set -e); caller checks for empty output
}

download_rootfs() {
    mkdir -p "$IMAGES_DIR"
    local dest="$IMAGES_DIR/astrolinux-trixie-rk3568-$RELEASE_TAG.img.gz"
    echo "OpenAstro Linux $RELEASE_TAG image not found locally. Downloading..." >&2
    echo "  $RELEASE_URL" >&2
    echo "" >&2
    # Download to .part and rename on success so an interrupted download
    # can never be mistaken for a complete cached image.
    if command -v wget >/dev/null 2>&1; then
        wget -O "$dest.part" "$RELEASE_URL" || { rm -f "$dest.part"; echo "Download failed." >&2; exit 1; }
    elif command -v curl >/dev/null 2>&1; then
        curl -fL -o "$dest.part" "$RELEASE_URL" || { rm -f "$dest.part"; echo "Download failed." >&2; exit 1; }
    else
        echo "ERROR: wget or curl required. Download manually:" >&2
        echo "  mkdir -p images" >&2
        echo "  wget -O images/astrolinux-trixie-rk3568-$RELEASE_TAG.img.gz $RELEASE_URL" >&2
        exit 1
    fi
    mv "$dest.part" "$dest"
    echo "" >&2
    echo "Downloaded: $dest ($(du -h "$dest" | cut -f1))" >&2
    echo "$dest"
}

# Pull out --no-wifi from anywhere in the args; leave the positional image arg.
ARGS=()
for a in "$@"; do
    case "$a" in
        --no-wifi) export OPENASTRO_WIFI=no ;;
        *) ARGS+=("$a") ;;
    esac
done
set -- "${ARGS[@]}"

# An explicit image path skips release resolution entirely (no network).
if [ -n "$1" ]; then
    ROOTFS_ARG="$1"
else
    resolve_release "$IMAGES_DIR"
    ROOTFS_ARG="$(find_rootfs)"
    [ -n "$ROOTFS_ARG" ] || ROOTFS_ARG="$(download_rootfs)"
fi

if [ ! -x "$TOOL" ]; then
    echo "rk-flashtool not found. Build it first."
    exit 1
fi

# Find rootfs image - try .img, then .img.gz
ROOTFS_IMG="$ROOTFS_ARG"
if [ ! -f "$ROOTFS_IMG" ] && [ -f "${ROOTFS_IMG}.gz" ]; then
    ROOTFS_IMG="${ROOTFS_IMG}.gz"
fi

if [ ! -f "$ROOTFS_IMG" ]; then
    echo "Rootfs image not found: $ROOTFS_ARG"
    echo "Usage: sudo scripts/flash-rootfs [rootfs-image]"
    exit 1
fi

# Decompress .gz images to a temp file
if [[ "$ROOTFS_IMG" == *.gz ]]; then
    WORKDIR="$(pick_workdir "$ROOTFS_IMG")" || {
        echo "ERROR: need ~4.5 GB of free space to decompress the image, but"
        echo "none of TMPDIR, the image directory, /var/tmp, or /tmp has enough."
        echo "Free up space or set TMPDIR to a larger filesystem, then retry."
        exit 1
    }
    echo "Decompressing $(basename "$ROOTFS_IMG") into $WORKDIR..."
    TMPIMG="$(mktemp "$WORKDIR/astrolinux-rootfs-XXXXXX.img")"
    trap 'rm -f "$TMPIMG"' EXIT
    gunzip -c "$ROOTFS_IMG" > "$TMPIMG" || {
        echo "ERROR: decompression failed (out of space?)."
        exit 1
    }
    ROOTFS_IMG="$TMPIMG"
    echo "Done ($(du -h "$ROOTFS_IMG" | cut -f1))."
    echo ""
fi

configure_wifi_in_image "$ROOTFS_IMG" || {
    echo "WiFi setup failed; aborting before flash."
    exit 1
}

$TOOL ld 2>/dev/null | grep -q "Loader\|Maskrom" || {
    echo "No ASIAIR found in Loader or Maskrom mode."
    exit 1
}

SIZE=$(du -h "$ROOTFS_IMG" | cut -f1)
echo "Flashing rootfs to p7 (sector 0x1BD38000)..."
echo "  Image: $ROOTFS_IMG ($SIZE)"
echo "  This may take several minutes over USB..."
$TOOL wl 0x1BD38000 "$ROOTFS_IMG"
echo "Done."
