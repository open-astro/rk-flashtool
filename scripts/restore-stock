#!/bin/bash
set -e

# Everything below needs root (raw USB flashing, loop-mounting the image).
if [ "$(id -u)" -ne 0 ]; then
    echo "ERROR: this script must be run as root:" >&2
    echo "  sudo $0 $*" >&2
    exit 1
fi

# Restore stock ASIAIR firmware from backup.
#
# Two modes:
#   1. Default - restores the stock kernel (p3) and rootfs (p7). Works in
#      Loader mode (hold reset, plug in USB, then power on). p3 is included
#      because a mainline-kernel image replaces it; the stock rootfs only boots
#      with the stock kernel.
#   2. Full restore - restores bootloader + all partitions. For recovery from a
#      bricked device. Requires Maskrom mode.
#
# Usage:
#   sudo scripts/restore-stock          # kernel + rootfs (Loader mode)
#   sudo scripts/restore-stock --full   # full restore (Maskrom mode)

REPODIR="$(cd "$(dirname "$0")/.." && pwd)"
TOOL="$REPODIR/rk-flashtool"
BACKUP="${BACKUP_DIR:-$REPODIR/asiair-backup}"

FULL_RESTORE=false
if [ "${1:-}" = "--full" ]; then
    FULL_RESTORE=true
fi

# -f, not just -x: in a checkout that contains a nested clone named
# rk-flashtool/, -x is true for the directory and every "$TOOL ld" call
# then fails silently ("No ASIAIR found" even with the device in Loader).
if [ ! -f "$TOOL" ] || [ ! -x "$TOOL" ]; then
    echo "rk-flashtool binary not found at: $TOOL"
    [ -d "$TOOL" ] && echo "  ($TOOL is a directory - run this script from that checkout instead)"
    echo "Build it first:"
    echo "  ./autogen.sh && ./configure && make"
    exit 1
fi

# --- Verify backup ---

find_backup() {
    ls -1t "$BACKUP"/*_"$1" 2>/dev/null | head -1
}

ROOTFS=$(find_backup "p7_rootfs.bin")

if [ -z "$ROOTFS" ]; then
    echo "ERROR: Stock rootfs backup not found in: $BACKUP"
    echo "Cannot restore without a backup of partition 7."
    exit 1
fi

if $FULL_RESTORE; then
    BOOTLOADER=$(find_backup "bootloader_pre_partition.bin")
    UBOOT=$(find_backup "p1_uboot.bin")
    BOOT=$(find_backup "p3_boot.bin")
    PI_PART=$(find_backup "p6_pi.bin")

    MISSING=""
    [ -z "$BOOTLOADER" ] && MISSING="$MISSING  bootloader_pre_partition.bin\n"
    [ -z "$UBOOT" ] && MISSING="$MISSING  p1_uboot.bin\n"
    [ -z "$BOOT" ] && MISSING="$MISSING  p3_boot.bin\n"

    if [ -n "$MISSING" ]; then
        echo "ERROR: Full restore requires these backup files in: $BACKUP"
        echo -e "$MISSING"
        echo "Run scripts/backup first, or use rootfs-only restore (without --full)."
        exit 1
    fi
fi

# --- Verify backup sizes (sanity check) ---

check_size() {
    local file="$1"
    local min_bytes="$2"
    local label="$3"
    local actual
    actual=$(stat -c%s "$file" 2>/dev/null || echo 0)
    if [ "$actual" -lt "$min_bytes" ]; then
        echo "WARNING: $label backup looks too small ($actual bytes)."
        echo "  File: $file"
        echo "  This may indicate a corrupted or incomplete backup."
        read -rp "  Continue anyway? [y/N] " answer
        case "$answer" in
            [yY]*) ;;
            *) echo "Aborted."; exit 1 ;;
        esac
    fi
}

check_size "$ROOTFS" 1000000000 "Rootfs (p7)"
if $FULL_RESTORE; then
    check_size "$BOOTLOADER" 1000000 "Bootloader"
    check_size "$UBOOT" 1000000 "U-Boot (p1)"
    check_size "$BOOT" 10000000 "Boot image (p3)"
fi

# --- Begin restore ---

if $FULL_RESTORE; then
    echo "=== Full Stock Restore (Maskrom) ==="
    echo ""
    echo "This will restore the entire stock firmware from your backup:"
    echo "  - Bootloader (pre-partition area)"
    echo "  - U-Boot (p1)"
    echo "  - Boot image (p3)"
    echo "  - Rootfs (p7)"
    [ -n "$PI_PART" ] && echo "  - /home/pi (p6)"
    echo ""
    echo "The device must be in Maskrom mode."
    echo ""

    $TOOL ld 2>/dev/null | grep -q "Maskrom" || {
        if $TOOL ld 2>/dev/null | grep -q "Loader"; then
            echo "Device is in Loader mode, but full restore requires Maskrom."
            echo ""
            echo "To enter Maskrom: power off, open enclosure, short eMMC CLK, power on."
            echo "See hardware/asiair-plus-rk3568-256g/flashtool-recovery.md"
            echo ""
            echo "Or for rootfs-only restore (safer): sudo scripts/restore-stock"
        else
            echo "No ASIAIR found in Maskrom mode."
            echo ""
            echo "To enter Maskrom: power off, open enclosure, short eMMC CLK, power on."
        fi
        exit 1
    }

    echo "Device in Maskrom - loading DDR/SPL..."
    LOADER=""
    if [ -f "$REPODIR/blobs/rk356x_spl_loader_v1.23.114.bin" ]; then
        LOADER="$REPODIR/blobs/rk356x_spl_loader_v1.23.114.bin"
    elif [ -f "$(dirname "$REPODIR")/rkbin/rk356x_spl_loader_v1.23.114.bin" ]; then
        LOADER="$(dirname "$REPODIR")/rkbin/rk356x_spl_loader_v1.23.114.bin"
    fi
    if [ -z "$LOADER" ]; then
        echo "Loader blob not found in blobs/ directory."
        exit 1
    fi
    $TOOL db "$LOADER"
    sleep 2

    echo "Restoring bootloader (pre-partition area)..."
    $TOOL wl 0 "$BOOTLOADER"
    sleep 3

    echo "Restoring U-Boot (p1)..."
    $TOOL wl 0x4000 "$UBOOT"
    sleep 3

    echo "Restoring boot image (p3)..."
    $TOOL wl 0x8000 "$BOOT"
    sleep 3

    echo "Restoring rootfs (p7) - this will take several minutes..."
    $TOOL wl 0x1BD38000 "$ROOTFS"

    if [ -n "$PI_PART" ]; then
        sleep 3
        echo "Restoring /home/pi (p6)..."
        $TOOL wl 0x1BC38000 "$PI_PART"
    fi

else
    BOOT=$(find_backup "p3_boot.bin")

    echo "=== Restore Stock Kernel + Rootfs ==="
    echo ""
    echo "This will restore from your backup:"
    [ -n "$BOOT" ] && echo "  - stock kernel   (p3)  $(basename "$BOOT")"
    echo "  - stock rootfs   (p7)  $(basename "$ROOTFS")"
    echo "All OpenAstro Linux data will be overwritten."
    echo "The bootloader is not modified."
    if [ -z "$BOOT" ]; then
        echo ""
        echo "WARNING: no *_p3_boot.bin backup found. If this unit ran a"
        echo "mainline-kernel image, the stock rootfs will not boot without it."
    fi
    echo ""

    LD_OUT=$($TOOL ld 2>&1 || true)
    if ! echo "$LD_OUT" | grep -q "Loader"; then
        if echo "$LD_OUT" | grep -q "Maskrom"; then
            echo "Device is in Maskrom mode; use: sudo $0 --full"
        else
            echo "No ASIAIR found in Loader mode. rk-flashtool said:"
            echo "  $LD_OUT"
            echo ""
            echo "To enter Loader mode: hold down the reset button, plug in USB,"
            echo "then plug in power and turn the ASIAIR on, still holding reset."
            echo "Release after about 5 seconds."
        fi
        exit 1
    fi

    if [ -n "$BOOT" ]; then
        echo "Restoring stock kernel (p3)..."
        $TOOL wl 0x8000 "$BOOT"
        sleep 2
    fi
    echo "Restoring stock rootfs (p7) - this will take several minutes..."
    $TOOL wl 0x1BD38000 "$ROOTFS"
fi

echo ""
echo "=== Restore complete. Resetting device... ==="
$TOOL rd || true

echo ""
echo "Stock ASIAIR firmware has been restored."
echo "The device will boot the original ZWO software."
echo ""
echo "  Default SSH: pi@asiair (password: raspberry)"
echo "  Requires jailbreak for SSH access."
